{
  "mesh": "dev",
  "description": "Developer mesh for implementing features, writing code, and running tests",
  "worktree": true,
  "agents": [
    {
      "name": "worker",
      "model": "opus",
      "prompt": "prompt.md"
    }
  ],
  "entry_point": "worker",
  "routing": {
    "worker": {
      "complete": {
        "core": "Implementation complete"
      },
      "blocked": {
        "core": "Need clarification or human input"
      },
      "ask": {
        "brain": "Need project knowledge from spec-graph"
      }
    }
  }
}
