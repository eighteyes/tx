# MCP Server Environment Variables
# Copy this file to .mcp.env and fill in your credentials
# .mcp.env is gitignored - never commit actual credentials

# Google Calendar MCP (@cocal/google-calendar-mcp)
# Used by: meshes/protagents/meet
# Path to OAuth credentials JSON file (download from Google Cloud Console)
GOOGLE_OAUTH_CREDENTIALS=

# Optional: Custom token storage location
# GOOGLE_CALENDAR_MCP_TOKEN_PATH=

# Relay MCP (Protagent remote execution)
# Used by: remote agent meshes
RELAY_API_KEY=
RELAY_ENDPOINT=

# Slack MCP
# Used by: notification agents
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# GitHub MCP
# Used by: PR/issue automation
GITHUB_TOKEN=

# Add other MCP server credentials below as needed
# Format: KEY=value (no quotes needed for simple values)
# Multi-line or special characters: Use quotes
